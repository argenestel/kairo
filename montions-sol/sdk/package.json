{
  "name": "@montions/solana-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Montions on Solana: outcome-first binary options with a fully onchain CLOB.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "sync-idl": "node scripts/sync-idl.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "init-devnet": "tsx ../scripts/init-devnet.ts",
    "seed-markets": "tsx ../scripts/seed-markets.ts",
    "status": "tsx ../scripts/status.ts",
    "keeper": "tsx ../keeper/keeper.ts",
    "local-e2e": "tsx ../scripts/local-e2e.ts",
    "devnet-launch": "bash ../scripts/devnet-launch.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
